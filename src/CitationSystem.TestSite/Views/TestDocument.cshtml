@using CitationSystem.Models
@using CitationSystem.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject CitationNumberingService CitationNumberingService
@{
    Layout = null;
    var pageCitationUsage = CitationNumberingService.GetPageCitationUsage(Model);
    var citations = Model.Value<IReadOnlyList<CitationRecord>>("citationManager") ?? [];
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.Name</title>
</head>
<body>
    <h1>@Model.Name</h1>

    <h2>generalInfo</h2>
    @Html.WithCitations(Model, "generalInfo")

    <h2>test2Rte</h2>
    @Html.WithCitations(Model, "test2Rte")

    <h2>Block List</h2>
    @Html.GetBlockListHtml(Model, "blocklisttest")

    <h2>Numbering</h2>
    <p>Numbered citations: @(pageCitationUsage?.CitationUsages.Count ?? 0)</p>
    @if (pageCitationUsage is not null)
    {
        <ul>
            @foreach (var usage in pageCitationUsage.CitationUsages.OrderBy(entry => entry.Value.CitationNumber))
            {
                var title = citations.FirstOrDefault(citation => citation.ID == usage.Key)?.Title;
                <li>[@(usage.Value.CitationNumber)] @title, used @(usage.Value.CitationUseCount)</li>
            }
        </ul>
    }
    <p>&nbsp;</p>

    <p>&nbsp;</p>

    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>
    <p>&nbsp;</p>

    <h2>Bibliography test</h2>
    @await Html.GetBibliographyHtmlAsync()
</body>
</html>
